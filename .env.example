# PostgreSQL
POSTGRES_USER=vycord
POSTGRES_PASSWORD=vycord_secret
POSTGRES_DB=vycord
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Server
SERVER_PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=720h

# CORS
CLIENT_URL=http://localhost:3000

# TURN relay (optional in dev — leave empty to disable; clients use STUN only).
# In prod see .env.prod.example: TURN_SECRET must match coturn's static-auth-secret.
TURN_SECRET=
TURN_URLS=
TURN_CREDENTIAL_TTL=12h

# Voice-presence reconciliation against the SFU (optional in dev — leave empty
# to disable; the API just runs without it, same as an unset TURN_SECRET).
# In prod see .env.prod.example. api and sfu both run natively on localhost in
# dev (make run-api / make run-sfu), so no host.docker.internal indirection is
# needed here.
SFU_INTERNAL_SECRET=
SFU_INTERNAL_URL=http://localhost:8081

# File storage (avatars)
UPLOAD_DIR=./uploads

# Срок жизни подписанной ссылки на вложение (по умолчанию 168h = 7 суток)
ATTACHMENT_LINK_TTL=168h

# Предохранитель на сырое тело запроса загрузки вложения, в байтах (по
# умолчанию 30 МиБ = 31457280). Это НЕ лимит размера файла — тот задаёт
# max_file_bytes в таблице plans. Инвариант: это значение и
# client_max_body_size в nginx обязаны быть НЕ МЕНЬШЕ, чем max_file_bytes
# самого щедрого тарифа, иначе платный тариф не заработает — запрос обрубит
# один из этих двух предохранителей раньше, чем дело дойдёт до проверки по
# плану.
MAX_UPLOAD_BYTES=31457280
