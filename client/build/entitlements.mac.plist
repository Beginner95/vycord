<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Base set from electron-builder's built-in template (notarization/JIT requirements) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Camera + microphone: Hardened Runtime entitlements. Without these,
         getUserMedia resolves and the track reports readyState "live" but
         no frames/audio ever arrive, with no TCC prompt and no error —
         electron-builder/electron-builder#9529. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- App Sandbox alias for the microphone; unused outside the Mac App
         Store but harmless to include. -->
    <key>com.apple.security.device.microphone</key>
    <true/>
  </dict>
</plist>
