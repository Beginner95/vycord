# Copy to .env (gitignored), fill in, and `source` it before running smoke.mjs.
# Ask the maintainer for the smoke-account credentials — never commit them.
export VYCORD_SMOKE_EMAIL=
export VYCORD_SMOKE_PASSWORD=
# Optional: point at a local server instead of the default prod API host.
# export VYCORD_SMOKE_API=http://localhost:8080
