# PostgreSQL
POSTGRES_USER=vycord
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vycord
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Server
SERVER_PORT=8080
SFU_PORT=8081
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=720h

# SFU: public IP of the server (required when SFU runs inside Docker).
# Without this, pion advertises Docker-internal IPs that clients cannot reach.
# Also used as coturn's --relay-ip so TURN relays only on the public address.
SFU_PUBLIC_IP=YOUR_SERVER_PUBLIC_IP

# SFU internal HTTP API (VYC-78 step 4): guards /stats and /presence, which
# would otherwise be reachable from the open internet unauthenticated — the
# SFU listens on ":"+SFU_PORT under network_mode: host (required for WebRTC
# ICE), so its HTTP surface is bound to every interface, not just localhost.
# Read by BOTH containers (api sends it, sfu checks it) — env_file: .env.prod
# is shared by both in docker-compose.prod.yml, so one value here covers both.
# Generate with: openssl rand -hex 32
SFU_INTERNAL_SECRET=CHANGE_ME_RANDOM_INTERNAL_SECRET
# host.docker.internal resolves via the extra_hosts entry docker-compose.prod.yml
# adds to the api service: api runs in the bridge network, sfu runs with
# network_mode: host, so api reaches it through the host gateway, not 127.0.0.1.
SFU_INTERNAL_URL=http://host.docker.internal:8081

# TURN (coturn): relay for clients behind symmetric NAT / VPN — without it
# such clients get dropped from calls or never get media at all.
# TURN_SECRET must match coturn's --static-auth-secret (docker-compose.prod.yml
# passes this same variable there). Generate with: openssl rand -hex 32
TURN_SECRET=CHANGE_ME_RANDOM_TURN_SECRET
# Comma-separated URLs handed out to clients. The hostname must resolve to this
# server; open 3478/udp and the relay range 49160-49360/udp.
#
# UDP ONLY, deliberately (VYC-76). A TCP relay was in this list and had to go:
# TCP guarantees delivery and blocks head-of-line, so when the direct UDP path
# faltered and ICE fell back to the TCP relay, the relay HELD the publisher's
# audio for a second or two and then released all of it at once. Every listener
# of that publisher got an oversized jitter buffer and their NetEq time-
# compressed playout to drain it — the "that person suddenly talks fast" report.
# Measured on prod: the TCP relay appeared in exactly 1 of 202 sampled ICE-path
# ticks, and that one tick is the instant of the burst; nobody was living on it.
#
# A relay over UDP simply drops what it cannot deliver, so a failing path costs
# a moment of silence instead of a burst. The trade is that clients on networks
# which block UDP outright can no longer connect at all — if that ever needs
# revisiting, re-add transport=tcp and expect the speed-up to return with it.
TURN_URLS=turn:api.vycord.webvaha.ru:3478?transport=udp
# Lifetime of ephemeral credentials; must exceed the longest expected call.
TURN_CREDENTIAL_TTL=12h

# Frontend build URLs (baked in at build time)
VITE_API_URL=https://api.vycord.webvaha.ru
VITE_WS_URL=wss://api.vycord.webvaha.ru
VITE_SFU_URL=wss://api.vycord.webvaha.ru/sfu

# CORS
CLIENT_URL=https://front.vycord.webvaha.ru

# File storage (avatars) — must point at a persistent volume that survives
# API redeploys, not a path inside a container/build artifact.
UPLOAD_DIR=/var/lib/vycord/uploads

# Срок жизни подписанной ссылки на вложение (по умолчанию 168h = 7 суток)
ATTACHMENT_LINK_TTL=168h

# Предохранитель на сырое тело запроса загрузки вложения, в байтах (по
# умолчанию 30 МиБ = 31457280). Это НЕ лимит размера файла — тот задаёт
# max_file_bytes в таблице plans. Инвариант: это значение и
# client_max_body_size в deploy/nginx/api.vycord.webvaha.ru.conf обязаны быть
# НЕ МЕНЬШЕ, чем max_file_bytes самого щедрого тарифа, иначе платный тариф не
# заработает — запрос обрубит один из этих двух предохранителей раньше, чем
# дело дойдёт до проверки по плану.
MAX_UPLOAD_BYTES=31457280

# Error reporting (GlitchTip, self-hosted Sentry-protocol-compatible tracker).
# See README.md "Error reporting (GlitchTip)" for first-deploy steps.
GLITCHTIP_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_openssl_rand_hex_32
GLITCHTIP_DOMAIN=https://errors.vycord.webvaha.ru
# Only host(s) allowed to hit the GlitchTip web UI/ingest (see ALLOWED_HOSTS).
GLITCHTIP_ALLOWED_HOSTS=errors.vycord.webvaha.ru
# Reuses the same Postgres instance as the app (separate `glitchtip` database)
# and the same Redis instance (separate db index) — no second stack.
GLITCHTIP_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/glitchtip
GLITCHTIP_REDIS_URL=redis://redis:6379/1
# consolemail:// disables outgoing email (org-invite/digest emails are not
# needed for MVP) — GlitchTip still works fully for event ingestion/viewing.
EMAIL_URL=consolemail://

# Client bundle: public DSN from the GlitchTip project created after first
# deploy (see README) — not a secret, safe to commit once known.
VITE_SENTRY_DSN=https://ff00f86de3ec44ab90908405a78fbcab@errors.vycord.webvaha.ru/1
