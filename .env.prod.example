# PostgreSQL
POSTGRES_USER=vycord
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=vycord
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Server
SERVER_PORT=8080
SFU_PORT=8081
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=24h

# SFU: public IP of the server (required when SFU runs inside Docker).
# Without this, pion advertises Docker-internal IPs that clients cannot reach.
# Also used as coturn's --relay-ip so TURN relays only on the public address.
SFU_PUBLIC_IP=YOUR_SERVER_PUBLIC_IP

# TURN (coturn): relay for clients behind symmetric NAT / VPN — without it
# such clients get dropped from calls or never get media at all.
# TURN_SECRET must match coturn's --static-auth-secret (docker-compose.prod.yml
# passes this same variable there). Generate with: openssl rand -hex 32
TURN_SECRET=CHANGE_ME_RANDOM_TURN_SECRET
# Comma-separated URLs handed out to clients. The hostname must resolve to this
# server; open 3478/udp + 3478/tcp, 5349/tcp (TLS) and the relay range
# 49160-49360/udp. Order: udp, tcp, tls — ICE tries all in parallel.
TURN_URLS=turn:api.vycord.webvaha.ru:3478?transport=udp,turn:api.vycord.webvaha.ru:3478?transport=tcp,turns:api.vycord.webvaha.ru:5349?transport=tcp
# Lifetime of ephemeral credentials; must exceed the longest expected call.
TURN_CREDENTIAL_TTL=12h

# Frontend build URLs (baked in at build time)
VITE_API_URL=https://api.vycord.webvaha.ru
VITE_WS_URL=wss://api.vycord.webvaha.ru
VITE_SFU_URL=wss://api.vycord.webvaha.ru/sfu

# CORS
CLIENT_URL=https://front.vycord.webvaha.ru
